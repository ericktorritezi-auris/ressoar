<%
const rotulos = {
  master: 'Master',
  gestor_carteira: 'Administrador de carteira',
  prefeito_secretario: 'Prefeito / Secretário',
  servidor: 'Servidor municipal',
  responsavel_dados: 'Responsável pelos dados',
};
%>
<%- include('../partials/shell-inicio', { titulo: 'Usuários', paginaAtiva: 'usuarios', usuario: usuario, versao: versao }) %>
<div class="rsr-toolbar">
  <h1>Usuários</h1>
  <a class="rsr-btn rsr-btn-primario" style="padding:0 18px;display:inline-flex;align-items:center" href="/usuarios/novo">+ Novo usuário</a>
</div>

<% if (usuarios.length === 0) { %>
  <div class="rsr-card rsr-vazio">Nenhum usuário cadastrado ainda.</div>
<% } else { %>
  <div class="rsr-table-wrap">
    <table class="rsr-table">
      <thead>
        <tr><th>Nome</th><th>E-mail</th><th>Perfil</th><th>Município</th><th>Status</th><th></th></tr>
      </thead>
      <tbody>
        <% usuarios.forEach((u) => { %>
          <tr>
            <td style="font-weight:600"><%= u.nome %></td>
            <td><%= u.email %></td>
            <td><span class="rsr-badge"><%= rotulos[u.perfil] || u.perfil %></span></td>
            <td><%= u.municipio_nome || '—' %></td>
            <td><%- u.ativo ? '<span class="rsr-badge rsr-badge-mint">Ativo</span>' : '<span class="rsr-badge rsr-badge-neutro">Inativo</span>' %></td>
            <td><a href="/usuarios/<%= u.id %>/editar" style="font-size:13px">Editar</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
<%- include('../partials/shell-fim', { versao: versao }) %>
