<%- include('../partials/shell-inicio', { titulo: 'Painel', paginaAtiva: 'painel', usuario: usuario, versao: versao }) %>
<div class="rsr-toolbar">
  <h1>Painel — <%= municipio.nome %></h1>
</div>

<% if (!somenteLeitura && usuario.perfil !== 'servidor') { %>
  <div class="rsr-card" style="margin-bottom:16px">
    <form method="POST" action="/painel/preferencias" style="display:flex;gap:16px;align-items:center;flex-wrap:wrap">
      <span style="font-size:13px;color:var(--text-soft)">Mostrar relatórios:</span>
      <% todosOsEixos.forEach((codigo) => { %>
        <label style="display:flex;align-items:center;gap:6px;font-size:13px">
          <input type="checkbox" name="eixos" value="<%= codigo %>" <%= eixosAtivos.includes(codigo) ? 'checked' : '' %>>
          <%= codigo %>
        </label>
      <% }) %>
      <button class="rsr-btn" type="submit" style="font-size:12px">Salvar</button>
    </form>
  </div>
<% } %>

<% if (relatorios.length === 0) { %>
  <div class="rsr-card">
    <p style="margin:0;font-size:13px;color:var(--text-soft)">
      Ainda não há valores de indicadores lançados para este município.
    </p>
  </div>
<% } else { %>
  <div style="display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(280px,1fr))">
    <% relatorios.forEach((r) => { %>
      <div class="rsr-card">
        <h2 style="margin:0 0 12px;font-size:15px"><%= r.eixoCodigo %>. <%= r.eixoNome %></h2>
        <div style="display:flex;flex-direction:column;gap:10px">
          <% r.indicadores.forEach((ind) => { %>
            <div style="display:flex;justify-content:space-between;align-items:baseline;gap:8px">
              <span style="font-size:13px"><%= ind.nome %></span>
              <span style="font-size:14px;font-weight:700">
                <%= ind.valorAtual %><%= ind.unidade ? ' ' + ind.unidade : '' %>
                <% if (ind.tendencia === 'subiu') { %><span style="color:var(--mint)">▲</span><% } %>
                <% if (ind.tendencia === 'desceu') { %><span style="color:var(--coral)">▼</span><% } %>
              </span>
            </div>
            <% if (ind.meta !== null) { %>
              <div style="font-size:11px;color:var(--text-soft);margin-top:-6px">Meta: <%= ind.meta %><%= ind.unidade ? ' ' + ind.unidade : '' %></div>
            <% } %>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>
<%- include('../partials/shell-fim', { versao: versao }) %>
