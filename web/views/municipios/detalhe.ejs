<%
const ROTULOS = {
  mesorregiao: 'Mesorregião',
  microrregiao: 'Microrregião',
  regiao: 'Região geográfica',
  regiao_imediata: 'Região geográfica imediata',
  area_km2: 'Área territorial (km²)',
  populacao: 'População (estimativa)',
  populacao_censo_2022: 'População (Censo 2022)',
  densidade_hab_km2: 'Densidade (hab/km²)',
  pib_mil_reais: 'PIB (mil reais)',
  pib_per_capita: 'PIB per capita (R$)',
  taxa_alfabetizacao: 'Taxa de alfabetização (%)',
  // Busca única (2026-09-29): Siconfi (Finanças), InfoDengue (Saúde) e
  // IDHM/Atlas Brasil (aparece em "Outras fontes", por ser arquivo_auto).
  siconfi_receita_corrente_liquida: 'Receita corrente líquida',
  siconfi_despesa_total: 'Despesa total realizada',
  siconfi_pct_saude: '% investido em saúde',
  siconfi_pct_educacao: '% investido em educação',
  siconfi_divida_consolidada: 'Dívida consolidada líquida',
  dengue_casos_semana: 'Casos de dengue (última semana)',
  dengue_incidencia_100mil: 'Incidência de dengue (/100 mil hab.)',
  dengue_nivel_alerta: 'Nível de alerta (dengue)',
  idhm: 'IDHM',
  idhm_educacao: 'IDHM — Educação',
  idhm_longevidade: 'IDHM — Longevidade',
  idhm_renda: 'IDHM — Renda',
  escolarizacao_6a14: 'Escolarização 6-14 anos (%)',
  fora_da_escola_6a14: 'Fora da escola 6-14 anos (%)',
};
function rotuloChave(chave) {
  return ROTULOS[chave] || chave;
}
function formatarValor(v) {
  if (v.valor_numerico !== null && v.valor_numerico !== undefined) return Number(v.valor_numerico).toLocaleString('pt-BR');
  return v.valor_texto || '—';
}
// Blocos tematicos pedidos pelo usuario — só entram aqui as chaves que o
// IBGE realmente publica pronto (ver conversa/entrega para o que ficou de
// fora e por quê: piramide etaria/sexo/cor-raça/religião, salário médio,
// taxa de ocupação, estatísticas de empresas, IDEB, mortalidade infantil,
// infraestrutura hospitalar, saneamento, limites geográficos/malhas).
// Novo UX (2026-09-29): mesorregiao/microrregiao/regiao/regiao_imediata
// saíram do bloco "Território e geografia" porque agora aparecem no
// painel de Localização (breadcrumb ao lado do mapa) — mantê-las também
// aqui duplicaria a informação na mesma tela.
const BLOCOS = [
  { numero: '1', titulo: 'Território e geografia', chaves: ['area_km2'] },
  { numero: '2', titulo: 'Demografia', chaves: ['populacao', 'populacao_censo_2022', 'densidade_hab_km2'] },
  { numero: '3', titulo: 'Economia e trabalho', chaves: ['pib_mil_reais', 'pib_per_capita'] },
  { numero: '4', titulo: 'Educação', chaves: ['taxa_alfabetizacao'] },
];
const dadosPorChave = {};
dadosPublicos.forEach((v) => { dadosPorChave[v.chave] = v; });
const blocosComDados = BLOCOS
  .map((b) => ({ ...b, itens: b.chaves.map((c) => dadosPorChave[c]).filter(Boolean) }))
  .filter((b) => b.itens.length > 0);
// Bug #4 (achado na rodada de testes de 2026-09-28): dados importados de
// fontes que NAO sao IBGE (SIOPS, Siconfi, CNES, DATASUS, via Central de
// Atualizações) eram salvos corretamente mas nunca apareciam aqui — os
// BLOCOS acima so cobrem as chaves que o IBGE publica pronto. Qualquer
// chave que nao esteja em nenhum BLOCOS.chaves cai neste bloco genérico
// "Outros dados públicos", agrupado por fonte.
// Busca única (2026-09-29): Finanças (Siconfi) e Saúde (InfoDengue)
// ganham abas próprias, igual os blocos do IBGE — não caem no balaio
// genérico de "Outras fontes" (por isso entram no mesmo conjunto de
// exclusão abaixo). "dengue_serie_semanal" é tratado à parte (não é um
// rsr-stat, é o gráfico).
const CHAVES_FINANCAS = ['siconfi_receita_corrente_liquida', 'siconfi_despesa_total', 'siconfi_pct_saude', 'siconfi_pct_educacao', 'siconfi_divida_consolidada'];
const CHAVES_SAUDE = ['dengue_casos_semana', 'dengue_incidencia_100mil', 'dengue_nivel_alerta'];
const financas = CHAVES_FINANCAS.map((c) => dadosPorChave[c]).filter(Boolean);
const saude = CHAVES_SAUDE.map((c) => dadosPorChave[c]).filter(Boolean);
let serieDengueSemanal = [];
if (dadosPorChave.dengue_serie_semanal && dadosPorChave.dengue_serie_semanal.valor_texto) {
  try { serieDengueSemanal = JSON.parse(dadosPorChave.dengue_serie_semanal.valor_texto); } catch (e) { serieDengueSemanal = []; }
}
const chavesNosBlocosIbge = new Set([
  ...BLOCOS.flatMap((b) => b.chaves),
  ...CHAVES_FINANCAS,
  ...CHAVES_SAUDE,
  'dengue_serie_semanal',
]);
const outrosDados = dadosPublicos.filter((v) => !chavesNosBlocosIbge.has(v.chave));
const outrosDadosPorFonte = {};
outrosDados.forEach((v) => {
  const fonte = v.fonte_nome || 'Outra fonte';
  if (!outrosDadosPorFonte[fonte]) outrosDadosPorFonte[fonte] = [];
  outrosDadosPorFonte[fonte].push(v);
});
// Novo UX do Contexto do município (2026-09-29): faixa de KPIs (curadoria
// dos itens mais importantes, na ordem abaixo — só entra o que existir),
// painel de Localização (mapa + geografia) e os blocos temáticos viram
// abas em vez de ficarem todos sempre abertos (motivo do usuário: "ficou
// pesado"). Referência: página de município do IBGE Cidades, validada
// antes com uma demo interativa.
const ORDEM_KPIS = ['area_km2', 'populacao', 'densidade_hab_km2', 'pib_per_capita', 'taxa_alfabetizacao', 'populacao_censo_2022'];
const kpis = ORDEM_KPIS.map((c) => dadosPorChave[c]).filter(Boolean).slice(0, 6);
const CHAVES_GEOGRAFIA = ['mesorregiao', 'microrregiao', 'regiao_imediata', 'regiao'];
const geografia = CHAVES_GEOGRAFIA.map((c) => dadosPorChave[c]).filter(Boolean);
// "Fontes e notas": todo valor público exibido nesta tela, IBGE ou não —
// já carrega fonte + período + data de coleta (regra de arquitetura da
// seção 4), só faltava uma tela mostrando isso ao usuário.
const fontesENotas = [...geografia, ...blocosComDados.flatMap((b) => b.itens), ...financas, ...saude, ...outrosDados].map((v) => ({
  rotulo: rotuloChave(v.chave),
  fonte: v.fonte_nome,
  periodo: v.periodo_referencia || '—',
  coletadoEm: v.coletado_em,
}));
const eixosComIndicadores = eixos.map((e) => ({
  ...e,
  itens: indicadores.filter((i) => i.eixo_codigo === e.codigo),
}));
function formatarData(v) {
  if (!v) return null;
  const d = v instanceof Date ? v : new Date(v);
  return d.toLocaleDateString('pt-BR', { timeZone: 'UTC' });
}
// Nível de alerta epidemiológico (InfoDengue: 1 verde .. 4 vermelho) —
// cor por CSS (.rsr-alerta-1..4), texto já vem pronto em valor_texto.
function classeAlerta(v) {
  const n = v && v.valor_numerico;
  return 'rsr-alerta-' + (n >= 1 && n <= 4 ? n : 0);
}
// Dias ate o fim do mandato — só para exibição aqui; o alerta automático
// pelo sino (360/180/90/60/30/15 dias, para master + gestor de carteira)
// fica para quando a central de notificações for construída (combinado
// em 2026-09-28) — nenhuma rotina roda a partir disto ainda.
let diasParaFimMandato = null;
if (municipio.mandato_fim) {
  const hoje = new Date();
  const fim = new Date(municipio.mandato_fim);
  diasParaFimMandato = Math.ceil((fim.getTime() - Date.UTC(hoje.getFullYear(), hoje.getMonth(), hoje.getDate())) / 86400000);
}
%>
<%- include('../partials/shell-inicio', { titulo: municipio.nome, paginaAtiva: 'municipios', usuario: usuario, versao: versao }) %>
<div class="rsr-toolbar">
  <div class="rsr-entidade-header">
    <% if (municipio.brasao_url) { %>
      <img class="rsr-brasao" src="<%= municipio.brasao_url %>" alt="Brasão de <%= municipio.nome %>">
    <% } %>
    <div>
      <h1><%= municipio.nome %></h1>
      <div class="rsr-entidade-sub"><%= municipio.uf %><% if (dadosPorChave.regiao) { %> · Região <%= dadosPorChave.regiao.valor_texto %><% } %></div>
    </div>
  </div>
  <div style="display:flex;gap:10px;flex-wrap:wrap">
    <a class="rsr-btn rsr-btn-secundario" style="display:inline-flex;align-items:center;text-decoration:none" href="/municipios/<%= municipio.id %>/editar">Editar cadastro</a>
    <a class="rsr-btn rsr-btn-secundario" style="display:inline-flex;align-items:center;text-decoration:none" href="/municipios/<%= municipio.id %>/planilhas">Planilhas</a>
    <a class="rsr-btn rsr-btn-secundario" style="display:inline-flex;align-items:center;text-decoration:none" href="/municipios/<%= municipio.id %>/formularios">Formulários</a>
    <a class="rsr-btn rsr-btn-primario" style="padding:0 18px;display:inline-flex;align-items:center;text-decoration:none" href="/municipios/<%= municipio.id %>/indicadores/novo">+ Indicador</a>
  </div>
</div>

<% if (mensagem) { %><div class="rsr-sucesso" style="margin-bottom:16px"><%= mensagem %></div><% } %>
<% if (erro) { %><div class="rsr-erro" style="margin-bottom:16px"><%= erro %></div><% } %>

<% if (municipio.prefeito_nome || municipio.mandato_fim) { %>
<div class="rsr-card">
  <h2 style="margin:0 0 14px;font-size:16px;font-family:var(--font-display)">Mandato atual</h2>
  <div class="rsr-stats-grid">
    <% if (municipio.prefeito_nome) { %>
      <div class="rsr-stat">
        <div class="rsr-stat-rotulo">Prefeito</div>
        <div class="rsr-stat-valor" style="font-size:18px"><%= municipio.prefeito_nome %></div>
      </div>
    <% } %>
    <% if (municipio.prefeito_partido) { %>
      <div class="rsr-stat">
        <div class="rsr-stat-rotulo">Partido</div>
        <div class="rsr-stat-valor" style="font-size:18px"><%= municipio.prefeito_partido %></div>
      </div>
    <% } %>
    <% if (municipio.mandato_inicio || municipio.mandato_fim) { %>
      <div class="rsr-stat">
        <div class="rsr-stat-rotulo">Período do mandato</div>
        <div class="rsr-stat-valor" style="font-size:18px"><%= formatarData(municipio.mandato_inicio) || '—' %> a <%= formatarData(municipio.mandato_fim) || '—' %></div>
        <% if (diasParaFimMandato !== null) { %>
          <div class="rsr-stat-fonte">
            <% if (diasParaFimMandato < 0) { %>
              <span class="rsr-badge rsr-badge-neutro">Mandato encerrado</span>
            <% } else if (diasParaFimMandato <= 30) { %>
              <span class="rsr-badge rsr-badge-coral">Encerra em <%= diasParaFimMandato %> dia(s)</span>
            <% } else { %>
              <span class="rsr-badge">Encerra em <%= diasParaFimMandato %> dia(s)</span>
            <% } %>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
</div>
<% } %>

<div class="rsr-card">
  <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px">
    <h2 style="margin:0;font-size:16px;font-family:var(--font-display)">Contexto do município</h2>
    <div style="display:flex;gap:8px">
      <form method="POST" action="/municipios/<%= municipio.id %>/buscar-dados">
        <button class="rsr-btn rsr-btn-secundario" type="submit" <%= municipio.codigo_ibge ? '' : 'disabled' %>>Buscar dados do município</button>
      </form>
      <form method="POST" action="/municipios/<%= municipio.id %>/congelar-linha-base" onsubmit="return confirm('Congelar a linha de base agora, com os dados públicos atuais?')">
        <button class="rsr-btn rsr-btn-secundario" type="submit" <%= dadosPublicos.length ? '' : 'disabled' %>>Congelar linha de base</button>
      </form>
    </div>
  </div>

  <% if (!municipio.codigo_ibge) { %>
    <p style="font-size:13px;color:var(--text-soft);margin-top:14px">Cadastre um código IBGE para preencher dados públicos automaticamente.</p>
  <% } else if (dadosPublicos.length === 0) { %>
    <p style="font-size:13px;color:var(--text-soft);margin-top:14px">Nenhum dado público coletado ainda. Use "Buscar agora" ou aguarde a próxima coleta em lote.</p>
  <% } else { %>
    <% if (kpis.length > 0) { %>
      <div class="rsr-kpi-grid" style="margin-top:16px">
        <% kpis.forEach((v) => { %>
          <div class="rsr-kpi">
            <div class="rsr-kpi-rotulo"><%= rotuloChave(v.chave) %></div>
            <div class="rsr-kpi-valor"><%= formatarValor(v) %></div>
            <div class="rsr-kpi-periodo"><%= v.periodo_referencia || v.fonte_nome %></div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <div class="rsr-contexto-grid">
      <div class="rsr-localizacao">
        <div class="rsr-secao-titulo" style="margin-bottom:12px">Localização</div>
        <div class="rsr-mapa-frame">
          <% if (municipio.mapa_svg) { %>
            <%- municipio.mapa_svg %>
          <% } else { %>
            <div class="rsr-mapa-vazio">
              Mapa ainda não gerado.<br>
              <form method="POST" action="/municipios/<%= municipio.id %>/mapa/regenerar" style="margin-top:8px">
                <button class="rsr-btn rsr-btn-secundario" type="submit" style="height:32px;padding:0 12px;font-size:12px">Gerar mapa</button>
              </form>
            </div>
          <% } %>
        </div>
        <% if (geografia.length > 0) { %>
          <% geografia.forEach((g) => { %>
            <div class="rsr-geografia-linha"><span><%= rotuloChave(g.chave) %></span><span><%= formatarValor(g) %></span></div>
          <% }) %>
        <% } %>
        <% if (municipio.mapa_svg) { %>
          <form method="POST" action="/municipios/<%= municipio.id %>/mapa/regenerar" style="margin-top:12px" onsubmit="return confirm('Regenerar o mapa? Só é necessário se os limites do município mudaram oficialmente.')">
            <button class="rsr-btn rsr-btn-secundario" type="submit" style="height:30px;padding:0 10px;font-size:11px;width:100%">Regenerar mapa</button>
          </form>
        <% } %>
      </div>

      <div>
        <% const idAbas = 'ctx-' + municipio.id; %>
        <div class="rsr-abas" id="<%= idAbas %>">
          <% blocosComDados.forEach((bloco, i) => { %>
            <button type="button" class="rsr-aba-btn <%= i === 0 ? 'ativa' : '' %>" data-aba-alvo="<%= idAbas %>-<%= bloco.numero %>"><%= bloco.titulo %></button>
          <% }) %>
          <% if (financas.length > 0) { %>
            <button type="button" class="rsr-aba-btn" data-aba-alvo="<%= idAbas %>-financas">Finanças</button>
          <% } %>
          <% if (saude.length > 0 || serieDengueSemanal.length > 0) { %>
            <button type="button" class="rsr-aba-btn" data-aba-alvo="<%= idAbas %>-saude">Saúde</button>
          <% } %>
          <% if (Object.keys(outrosDadosPorFonte).length > 0) { %>
            <button type="button" class="rsr-aba-btn <%= blocosComDados.length === 0 ? 'ativa' : '' %>" data-aba-alvo="<%= idAbas %>-outras">Outras fontes</button>
          <% } %>
        </div>

        <% blocosComDados.forEach((bloco, i) => { %>
          <div class="rsr-aba-painel <%= i === 0 ? 'ativa' : '' %>" id="<%= idAbas %>-<%= bloco.numero %>">
            <div class="rsr-stats-grid">
              <% bloco.itens.forEach((v) => { %>
                <div class="rsr-stat">
                  <div class="rsr-stat-rotulo"><%= rotuloChave(v.chave) %></div>
                  <div class="rsr-stat-valor"><%= formatarValor(v) %></div>
                  <div class="rsr-stat-fonte"><%= v.fonte_nome %> · <%= v.periodo_referencia || '—' %></div>
                </div>
              <% }) %>
            </div>
          </div>
        <% }) %>

        <% if (financas.length > 0) { %>
          <div class="rsr-aba-painel" id="<%= idAbas %>-financas">
            <div class="rsr-stats-grid">
              <% financas.forEach((v) => { %>
                <div class="rsr-stat">
                  <div class="rsr-stat-rotulo"><%= rotuloChave(v.chave) %></div>
                  <div class="rsr-stat-valor"><%= formatarValor(v) %><% if (v.chave === 'siconfi_pct_saude' || v.chave === 'siconfi_pct_educacao') { %>%<% } %></div>
                  <div class="rsr-stat-fonte"><%= v.fonte_nome %> · <%= v.periodo_referencia || '—' %></div>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>

        <% if (saude.length > 0 || serieDengueSemanal.length > 0) { %>
          <div class="rsr-aba-painel" id="<%= idAbas %>-saude">
            <% if (saude.length > 0) { %>
              <div class="rsr-stats-grid" style="margin-bottom:14px">
                <% saude.forEach((v) => { %>
                  <div class="rsr-stat">
                    <div class="rsr-stat-rotulo"><%= rotuloChave(v.chave) %></div>
                    <% if (v.chave === 'dengue_nivel_alerta') { %>
                      <div style="margin-top:2px"><span class="rsr-badge <%= classeAlerta(v) %>" style="font-size:13px;padding:5px 12px"><%= v.valor_texto || formatarValor(v) %></span></div>
                    <% } else { %>
                      <div class="rsr-stat-valor"><%= formatarValor(v) %></div>
                    <% } %>
                    <div class="rsr-stat-fonte"><%= v.fonte_nome %> · <%= v.periodo_referencia || '—' %></div>
                  </div>
                <% }) %>
              </div>
            <% } %>
            <% if (serieDengueSemanal.length > 1) { %>
              <% const maxCasos = Math.max(...serieDengueSemanal.map((p) => p.casos), 1);
                 const larguraUtil = 460, alturaUtil = 100, xIni = 30, yBase = 118;
                 const pontosGrafico = serieDengueSemanal.map((p, i) => {
                   const x = xIni + (serieDengueSemanal.length === 1 ? 0 : (i * larguraUtil) / (serieDengueSemanal.length - 1));
                   const y = yBase - (p.casos / maxCasos) * alturaUtil;
                   return { x, y, casos: p.casos, semana: p.semana };
                 });
                 const pontosStr = pontosGrafico.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
                 const ultimoPonto = pontosGrafico[pontosGrafico.length - 1];
                 const picoPonto = pontosGrafico.reduce((max, p) => (p.casos > max.casos ? p : max), pontosGrafico[0]);
              %>
              <div class="rsr-chart-wrap">
                <div class="rsr-chart-titulo">Casos de dengue por semana epidemiológica — últimas <%= serieDengueSemanal.length %> semanas</div>
                <svg class="rsr-chart-svg" viewBox="0 0 560 140" width="100%" height="140" role="img"
                     aria-label="Série de casos de dengue por semana epidemiológica, de 0 a <%= maxCasos %> casos, pico de <%= picoPonto.casos %> na semana <%= picoPonto.semana %>">
                  <line x1="8" y1="18" x2="540" y2="18" stroke="var(--border)" stroke-width="1"/>
                  <line x1="8" y1="118" x2="540" y2="118" stroke="var(--border)" stroke-width="1"/>
                  <text x="10" y="14" font-size="10" fill="var(--text-soft)"><%= maxCasos %></text>
                  <text x="10" y="116" font-size="10" fill="var(--text-soft)">0</text>
                  <polyline fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" points="<%= pontosStr %>" />
                  <circle cx="<%= ultimoPonto.x.toFixed(1) %>" cy="<%= ultimoPonto.y.toFixed(1) %>" r="4" fill="var(--accent)" />
                  <text x="<%= (ultimoPonto.x + 6).toFixed(1) %>" y="<%= (ultimoPonto.y - 3).toFixed(1) %>" font-size="11" font-weight="700" fill="var(--text)"><%= ultimoPonto.casos %> casos</text>
                  <text x="<%= picoPonto.x.toFixed(1) %>" y="10" font-size="10" fill="var(--text-soft)" text-anchor="middle">pico: <%= picoPonto.casos %> (SE <%= picoPonto.semana %>)</text>
                </svg>
              </div>
            <% } %>
          </div>
        <% } %>

        <% if (Object.keys(outrosDadosPorFonte).length > 0) { %>
          <div class="rsr-aba-painel <%= blocosComDados.length === 0 ? 'ativa' : '' %>" id="<%= idAbas %>-outras">
            <% Object.keys(outrosDadosPorFonte).forEach((fonte, indice) => { %>
              <div class="<%= indice > 0 ? 'rsr-secao' : '' %>">
                <% if (Object.keys(outrosDadosPorFonte).length > 1) { %>
                  <div style="font-weight:700;font-size:13px;margin-bottom:10px"><%= fonte %></div>
                <% } %>
                <div class="rsr-stats-grid">
                  <% outrosDadosPorFonte[fonte].forEach((v) => { %>
                    <div class="rsr-stat" style="position:relative">
                      <div class="rsr-stat-rotulo"><%= rotuloChave(v.chave) %></div>
                      <div class="rsr-stat-valor"><%= formatarValor(v) %></div>
                      <div class="rsr-stat-fonte"><%= v.fonte_nome %> · <%= v.periodo_referencia || '—' %></div>
                      <form method="POST" action="/municipios/<%= municipio.id %>/dados-publicos/excluir"
                            onsubmit="return confirm('Excluir este dado importado? Isso remove o histórico dessa chave para esta fonte — pode subir o arquivo de novo depois, se precisar.')"
                            style="position:absolute;top:10px;right:10px">
                        <input type="hidden" name="chave" value="<%= v.chave %>">
                        <input type="hidden" name="fonte_codigo" value="<%= v.fonte_codigo %>">
                        <button type="submit" title="Excluir este dado"
                                style="background:none;border:none;color:var(--text-soft);cursor:pointer;font-size:14px;line-height:1;padding:2px 4px">✕</button>
                      </form>
                    </div>
                  <% }) %>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>

        <details class="rsr-fontes-notas">
          <summary>Fontes e notas</summary>
          <% fontesENotas.forEach((f) => { %>
            <div class="rsr-fontes-linha">
              <span class="rsr-fontes-chave"><%= f.rotulo %></span>
              <span class="rsr-fontes-meta"><%= f.fonte %></span>
              <span class="rsr-fontes-meta">período <%= f.periodo %></span>
            </div>
          <% }) %>
        </details>
      </div>
    </div>

    <script>
      (function () {
        document.getElementById('<%- idAbas %>').addEventListener('click', function (evento) {
          var botao = evento.target.closest('.rsr-aba-btn');
          if (!botao) return;
          var grupo = botao.parentElement;
          grupo.querySelectorAll('.rsr-aba-btn').forEach(function (b) { b.classList.remove('ativa'); });
          botao.classList.add('ativa');
          var alvoId = botao.getAttribute('data-aba-alvo');
          document.querySelectorAll('.rsr-aba-painel').forEach(function (p) { p.classList.remove('ativa'); });
          var alvo = document.getElementById(alvoId);
          if (alvo) alvo.classList.add('ativa');
        });
      })();
    </script>
  <% } %>

  <% if (snapshot.length > 0) { %>
    <p style="font-size:12px;color:var(--text-soft);margin-top:16px;padding-top:16px;border-top:1px solid var(--border)">
      Linha de base congelada em <%= new Date(snapshot[0].congelado_em).toLocaleDateString('pt-BR') %>
      (<%= snapshot.length %> valor(es)), usada como referência de evolução do programa.
    </p>
  <% } %>
</div>

<% if (municipio.codigo_ibge) { %>
<div class="rsr-card">
  <div class="rsr-secao-titulo">Fontes complementares (arquivo)</div>
  <div class="rsr-fonte-arquivo-lista">
    <div class="rsr-fonte-arquivo-item">
      <div class="rsr-fonte-arquivo-info">
        <div class="rsr-fonte-arquivo-nome">IDHM — Atlas do Desenvolvimento Humano (PNUD)</div>
        <div class="rsr-fonte-arquivo-desc">Baixado automaticamente do portal oficial · atualiza a cada Censo (dado mais recente: 2010)</div>
      </div>
      <div class="rsr-fonte-arquivo-acoes">
        <% if (dadosPorChave.idhm) { %>
          <span class="rsr-badge rsr-badge-mint">Importado · <%= dadosPorChave.idhm.periodo_referencia %></span>
        <% } else { %>
          <span class="rsr-badge rsr-badge-neutro">Nunca importado</span>
        <% } %>
        <form method="POST" action="/municipios/<%= municipio.id %>/buscar-idhm">
          <button class="rsr-btn rsr-btn-secundario" type="submit" style="height:38px;padding:0 14px;font-size:13px">Baixar e importar automaticamente</button>
        </form>
      </div>
    </div>
  </div>
  <p style="font-size:12px;color:var(--text-soft);margin:14px 0 0">
    SIOPS, CNES e DATASUS continuam manuais (sem endereço de arquivo estável conhecido) — disponíveis na
    <a href="/central-atualizacoes">Central de Atualizações</a>.
  </p>
</div>
<% } %>

<div class="rsr-card">
  <h2 style="margin:0 0 14px;font-size:16px;font-family:var(--font-display)">Catálogo de indicadores</h2>
  <% if (indicadores.length === 0) { %>
    <div class="rsr-vazio">Nenhum indicador cadastrado ainda para este município.</div>
  <% } else { %>
    <% eixosComIndicadores.forEach((eixo) => { if (eixo.itens.length === 0) return; %>
      <div style="margin-bottom:18px">
        <div style="font-weight:700;font-size:13px;margin-bottom:8px"><%= eixo.codigo %>. <%= eixo.nome %></div>
        <div class="rsr-table-wrap">
          <table class="rsr-table">
            <thead>
              <tr><th>Indicador</th><th>Linha de base</th><th>Meta</th><th>Periodicidade</th><th>Fonte</th><th></th></tr>
            </thead>
            <tbody>
              <% eixo.itens.forEach((i) => { %>
                <tr>
                  <td data-rotulo="Indicador"><%= i.nome %> <% if (!i.ativo) { %><span class="rsr-badge rsr-badge-neutro">Inativo</span><% } %></td>
                  <td data-rotulo="Linha de base"><%= i.linha_base !== null ? i.linha_base : '—' %> <%= i.unidade || '' %></td>
                  <td data-rotulo="Meta"><%= i.meta !== null ? i.meta : '—' %> <%= i.unidade || '' %></td>
                  <td data-rotulo="Periodicidade"><%= i.periodicidade %></td>
                  <td data-rotulo="Fonte"><span class="rsr-badge"><%= i.fonte_dado.replace('_', ' ') %></span></td>
                  <td data-rotulo=""><a href="/municipios/<%= municipio.id %>/indicadores/<%= i.id %>/editar" style="font-size:13px">Editar</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>
<%- include('../partials/shell-fim', { versao: versao }) %>
